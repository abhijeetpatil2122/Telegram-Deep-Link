{
  "name": "telegram-deep-link-watcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "check": "node --check src/crawl.js && node --check src/main.js && node --check src/publish.js",
    "crawl": "node --input-type=module -e \"import('./src/crawl.js').then(({ crawl }) => crawl())\"",
    "watch": "node src/main.js"
  }
}
